NODE_ENV=production
PORT=3020
BASE_DOMAIN=laba.zpseapil.club
DEVICE_HOST_SUFFIX=-laba.zpseapil.club
AUTH_MODE=cloudflare
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# One audience, or a comma-separated list when portal and device hosts use separate Access apps.
CF_ACCESS_AUD=replace-with-access-application-audience
SESSION_SECRET=replace-with-at-least-32-random-characters
DEVICE_SECRET_KEY=replace-with-32-byte-base64-key
ALLOWED_DEVICE_SUBNETS=192.168.0.0/24
DB_PATH=/opt/laba/data/portal.db
